# Runtime
JARVIS_REDIS_ADDR=127.0.0.1:6379
JARVIS_WORKER_ID=worker-01
JARVIS_WORKER_GROUP=jarvis:group:worker-pool
JARVIS_WORKER_CONSUMER=worker-01
JARVIS_WORKER_HEARTBEAT_INTERVAL_MS=3000
JARVIS_RUN_QUEUE_RECLAIM_IDLE_MS=65000
JARVIS_RUN_QUEUE_RECLAIM_INTERVAL_MS=5000
JARVIS_RUN_QUEUE_MAX_DELIVERIES=3
JARVIS_COMMAND_RECLAIM_IDLE_MS=5000
JARVIS_COMMAND_RECLAIM_INTERVAL_MS=1000
JARVIS_WORKSPACE_ROOT=/absolute/path/to/workspace
JARVIS_ARTIFACT_ROOT=/absolute/path/to/workspace/.local/artifacts
JARVIS_ARTIFACT_INLINE_MAX_BYTES=8192
JARVIS_ARTIFACT_MAX_FILE_BYTES=52428800
JARVIS_ARTIFACT_MAX_RUN_BYTES=262144000
JARVIS_ARTIFACT_MAX_WORKSPACE_BYTES=2147483648
JARVIS_ARTIFACT_MAX_TOTAL_BYTES=10737418240
# 多个允许根目录使用系统 PATH 分隔符（macOS/Linux 为冒号）
JARVIS_ALLOWED_WORKSPACE_PATHS=/absolute/path/to/workspace:/another/allowed/workspace

# Model provider
JARVIS_MODEL_ADAPTER=langchain
JARVIS_MODEL_PROVIDER=deepseek
JARVIS_MODEL_BASE_URL=https://api.deepseek.com
JARVIS_MODEL_NAME=deepseek-v4-flash
JARVIS_MODEL_THINKING_MODE=disabled
JARVIS_MODEL_API_KEY_ENV=DEEPSEEK_API_KEY
JARVIS_MODEL_TIMEOUT_SECONDS=120
JARVIS_MODEL_MAX_RETRIES=1
JARVIS_MODEL_MAX_TOKENS=4096
JARVIS_MODEL_CONTEXT_WINDOW_TOKENS=131072
JARVIS_AGENT_MAX_ITERATIONS=14
JARVIS_AGENT_MAX_RUN_SECONDS=900

# Memory v2 candidate extraction. Each completed task may add one model call.
JARVIS_MEMORY_EXTRACTION_ENABLED=true
JARVIS_MEMORY_EXTRACTION_POLL_INTERVAL_MS=1000
JARVIS_MEMORY_EXTRACTION_MAX_ATTEMPTS=3
JARVIS_MEMORY_EXTRACTION_STALE_SECONDS=300
JARVIS_MEMORY_CANDIDATE_EXPIRY_POLL_INTERVAL_MS=60000

# Local secret. Never commit a real value.
DEEPSEEK_API_KEY=

# RAG Embedding. The secret is read only from the named environment variable.
JARVIS_RAG_WORKER_ID=rag-worker-01
JARVIS_RAG_WORKER_POLL_INTERVAL_MS=1000
JARVIS_RAG_WORKER_ERROR_BACKOFF_MS=5000
JARVIS_RAG_JOB_LEASE_SECONDS=300
JARVIS_RAG_ASSET_ROOT=/absolute/path/to/workspace/.local/rag-assets
# paddleocr-vl 使用本地 MLX-VLM；没有视觉运行时的开发机可显式设为 native-only。
JARVIS_RAG_STRUCTURE_PROVIDER=paddleocr-vl
JARVIS_RAG_MLX_VLM_URL=http://127.0.0.1:8111/
JARVIS_RAG_STRUCTURE_CACHE_ROOT=
JARVIS_RAG_RENDER_DPI=144
JARVIS_RAG_PADDLE_MAX_PIXELS=4000000
JARVIS_RAG_PADDLE_MAX_NEW_TOKENS=4096
JARVIS_RAG_ASSET_MAX_FILE_BYTES=16777216
JARVIS_RAG_ASSET_MAX_TOTAL_BYTES=21474836480
JARVIS_RAG_EMBEDDING_MODEL=text-embedding-3-small
JARVIS_RAG_EMBEDDING_API_KEY_ENV=OPENAI_API_KEY
JARVIS_RAG_EMBEDDING_DIMENSIONS=1536
JARVIS_RAG_EMBEDDING_BATCH_SIZE=128
JARVIS_RAG_EMBEDDING_TIMEOUT_SECONDS=60
# Online pgvector HNSW search. Applied with SET LOCAL for each retrieval transaction.
JARVIS_RAG_HNSW_EF_SEARCH=100
JARVIS_RAG_HNSW_ITERATIVE_SCAN=relaxed_order
JARVIS_RAG_HNSW_MAX_SCAN_TUPLES=20000
JARVIS_RAG_HNSW_SCAN_MEM_MULTIPLIER=1
# Optional local Cross-Encoder sidecar. dev.sh enables it when the isolated runtime exists.
JARVIS_RAG_RERANKER_ENABLED=false
JARVIS_RAG_RERANKER_URL=http://127.0.0.1:8121
JARVIS_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
JARVIS_RAG_RERANKER_TIMEOUT_SECONDS=30
JARVIS_RAG_RERANKER_BATCH_SIZE=8
JARVIS_RAG_RERANKER_MAX_BATCH_TOKENS=4096
JARVIS_RAG_RERANKER_MAX_LENGTH=640
JARVIS_RAG_RERANKER_WARMUP=true
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
